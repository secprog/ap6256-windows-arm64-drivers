  <Target Name="Ap6256ValidateModel" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Ap6256HostCipherCandidate)'!='true' and '$(Ap6256HostCipherCandidate)'!='false'"
           Text="Ap6256HostCipherCandidate must be true or false." />
    <Error Condition="'$(Ap6256Wdi)'=='true' and '$(Ap6256Wifi)'=='true'" Text="WDI and WiFiCx are mutually exclusive. Select one upper edge." />
    <Error Condition="'$(Ap6256Model)'!='wdi' and '$(Ap6256Model)'!='wificx' and '$(Ap6256Model)'!='diagnostic'" Text="Unknown AP6256 model selection." />
    <Error Condition="'$(Ap6256Model)'=='wdi' and '$(Ap6256Wdi)'!='true'" Text="WDI sources require Ap6256Wdi=true." />
    <Error Condition="'$(Ap6256Model)'=='wificx' and ('$(Ap6256Wifi)'!='true' or '$(Ap6256Wdi)'=='true')" Text="WiFiCx sources require Ap6256Wifi=true and Ap6256Wdi=false." />
    <Error Condition="'$(Ap6256Model)'=='diagnostic' and ('$(Ap6256Wifi)'=='true' or '$(Ap6256Wdi)'=='true')" Text="Diagnostic sources require both network frontends disabled." />
  </Target>

  <Target Name="Ap6256RejectRetiredFtOptions" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Ap6256HostManagement)'!='' or '$(Ap6256NativeRrm)'!='' or '$(Ap6256NativeMgmt)'!=''"
      Text="Legacy management build switches are retired. Native firmware management is mandatory for exact images." />
    <Error Condition="'$(Ap6256HostFt)'=='true' or '$(Ap6256AuthCapture)'=='true' or '$(Ap6256FtRomProbe)'=='true' or '$(Ap6256RomFull)'=='true'"
           Text="Unsupported build configuration." />
  </Target>

  <Target Name="Ap6256ValidateWifiKit" BeforeTargets="PrepareForBuild"
          Condition="'$(Ap6256Wifi)'=='true'">
    <Error Condition="'$(Ap6256KitRoot)'==''"
           Text="WDKContentRoot is not set. Run from a WDK/EWDK environment or pass /p:Ap6256KitRoot=." />
  </Target>

  <Target Name="Ap6256StageDriverBinary" AfterTargets="DriverPackageTarget" BeforeTargets="Inf2Cat" Condition="'$(Ap6256PackageFirmware)'=='true'">
    <Error Condition="'$(Ap6256FirmwareRoot)'==''" Text="Set Ap6256FirmwareRoot to an external firmware directory." />
    <MakeDir Directories="$(OutDir)$(TargetName)\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OutDir)$(TargetName)\" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(Ap6256FirmwareRoot)\4345r9rtecdc.bin;$(Ap6256FirmwareRoot)\4345r9nvram.txt;$(Ap6256FirmwareRoot)\4345r9.clmb" DestinationFolder="$(OutDir)$(TargetName)\" SkipUnchangedFiles="false" />
  </Target>
  <ItemDefinitionGroup Condition="'$(Ap6256UseBuildVersion)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(Ap6256BuildMetadataDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>AP6256_BUILD_VERSION_GENERATED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(Ap6256BuildMetadataDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>AP6256_BUILD_VERSION_GENERATED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
